# Copy this file to .env and adjust as needed.
# Everything below already defaults to these same values in config.py,
# so an empty/missing .env still works -- this file is for when you want
# to override something (e.g. use a smaller/faster Whisper model).

SECRET_KEY=dev-secret-change-me
MAX_UPLOAD_MB=1024

# Ollama -- these match what your ORIGINAL scripts were already using
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_GENERATE_MODEL=qwen3:8b

# Whisper -- large-v2 matches your original mp3_to_json.py.
# For faster local testing, try: base, small, or medium
WHISPER_MODEL=large-v2
WHISPER_LANGUAGE=hi
WHISPER_TASK=translate

# Chunking / retrieval
CHUNK_GROUP_SIZE=5
TOP_K=5
SIMILARITY_THRESHOLD=0.35

# CORS: the URL your React dev server runs on
FRONTEND_ORIGIN=http://localhost:5173
